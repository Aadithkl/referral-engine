# ─── API & LLM ───
OPENAI_API_KEY=your_zen_api_key_here
OPENAI_BASE_URL=https://opencode.ai/zen/v1
OPENAI_MODEL_NAME=openai/deepseek-v4-flash-free

# ─── DATABASE ───
DATABASE_URL=sqlite:///./data/referral_engine.db
# For containers with persistent volume:
# DB_PATH=/data/referral_engine.db

# ─── TWITTER API ───
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=http://localhost:3000/auth/twitter/callback

# ─── WEBHOOK SECURITY ───
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_SIGNATURE_HEADER=X-Signature

# ─── REWARD SYSTEM ───
REWARD_TYPE=credits
BASE_REWARD=10

# ─── CURVE ARCHETYPES ───
INFLUENCER_HOOK_RATIO=1
INFLUENCER_VALLEY_DROP=0.25
INFLUENCER_VALLEY_STEPS=3
INFLUENCER_PEAK_RATIO=3
INFLUENCER_POST_CAP=2

BROADCASTER_HOOK_RATIO=1.2
BROADCASTER_VALLEY_DROP=0.1
BROADCASTER_VALLEY_STEPS=4
BROADCASTER_PEAK_RATIO=2.5
BROADCASTER_POST_CAP=1.3

FAN_HOOK_RATIO=0.6
FAN_VALLEY_DROP=0.7
FAN_VALLEY_STEPS=1
FAN_PEAK_RATIO=1.5
FAN_POST_CAP=1.5

NEWCOMER_HOOK_RATIO=0.4
NEWCOMER_VALLEY_DROP=0.25
NEWCOMER_VALLEY_STEPS=2
NEWCOMER_PEAK_RATIO=1.9
NEWCOMER_POST_CAP=2.5

# ─── VARIABLE REWARD ───
VARIANCE_FLOOR=0.75
VARIANCE_CEILING=1.4
JACKPOT_CHANCE=0.05
JACKPOT_MULTIPLIER=3.0

# ─── SCORING WEIGHTS ───
REACH_FOLLOWER_WEIGHT=0.4
REACH_ENGAGEMENT_WEIGHT=0.35
REACH_RELEVANCE_WEIGHT=0.25
ADVOCACY_USAGE_WEIGHT=0.4
ADVOCACY_TREND_WEIGHT=0.2
ADVOCACY_OUTCOME_WEIGHT=0.25
ADVOCACY_SENTIMENT_WEIGHT=0.15

# ─── TIER THRESHOLDS ───
REACH_LOW_MAX=33
REACH_MID_MAX=66
ADVOCACY_LOW_MAX=33
ADVOCACY_MID_MAX=66
QUADRANT_REACH_SPLIT=50
QUADRANT_ADVOCACY_SPLIT=50

# ─── RAW INPUT THRESHOLDS ───
RAW_FOLLOWERS_HIGH=1500
RAW_ENGAGEMENT_HIGH=0.01
RAW_SESSIONS_HIGH=50
RAW_FEATURES_HIGH=5

# ─── CAPACITY CALCULATION ───
PCU_PUBLIC_POST_CONVERSION=0.008
PCU_COMMUNITY_CONVERSION=0.035
PCU_DIRECT_MESSAGE_CONVERSION=0.25
OPTIMAL_ZONE_PERCENTAGE=0.75

# ─── TRIGGER GATES ───
MIN_ADVOCACY_FOR_ASK=50
MIN_ACCOUNT_AGE_DAYS=14
MAX_UNRESOLVED_TICKETS=0
ASK_COOLDOWN_DAYS=30
SUPPORT_TICKET_WINDOW_DAYS=90
SUPPORT_TICKET_COOLDOWN_DAYS=7
DECLINED_ASK_COOLDOWN_DAYS=21

# ─── PENALTY FLOORS ───
PENALTY_FLOOR_ADVOCACY=0.10
PENALTY_FLOOR_AGE=0.30
PENALTY_FLOOR_TICKETS=0.20
PENALTY_FLOOR_GLOBAL=0.05

# ─── ENGAGEMENT BENCHMARK ───
BENCHMARK_ENGAGEMENT_RATE=0.02

# ─── SERVER CONFIGURATION ───
HOST=0.0.0.0
PORT=3000
DEV=1

# ─── LANDING PAGE CONFIGURATION ───
LANDING_PAGE_DIR=./static
